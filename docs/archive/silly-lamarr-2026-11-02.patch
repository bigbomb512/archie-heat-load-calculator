+
+@contextmanager
+def _one_computation():
+    """Within this block, _once() works each value out once per saved state of the job's files."""
+    if _CALL_MEMO.get() is not None:
+        yield
+        return
+    token = _CALL_MEMO.set({})
+    try:
+        yield
+    finally:
+        _CALL_MEMO.reset(token)
